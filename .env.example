SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=job-media

# Canonical production origin(s) for mutation-origin validation. Comma-separate
# to allow both an apex and its www host. Must match the host actually served or
# every mutation is rejected as cross-site. Falls back to Netlify's URL if unset.
APP_ORIGIN=https://haulway.ca,https://www.haulway.ca

# Generate a long random value. This salts anonymous rate-limit keys.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
# Optional separate secret for hashing IP/device evidence. If omitted, the
# rate-limit secret is used. Keep either value server-only.
SECURITY_FINGERPRINT_SECRET=replace-with-a-different-32-character-random-value

# Required only for the initial named operator account. Remove after setup.
OPERATOR_SETUP_TOKEN=replace-with-at-least-32-random-characters
# Generate 32 random bytes and encode them as base64url or 64 hex characters.
# This encrypts operator authenticator secrets at rest and must remain stable.
OPERATOR_MFA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key

# Public business-controlled Interac destination. Do not use a personal inbox.
NEXT_PUBLIC_INTERAC_EMAIL=payments@haulway.ca
# Public contact named in the Alberta PIPA collection notice.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@haulway.ca

# Transactional request-update SMS. Prefer a restricted Twilio API key in production.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
# Required to verify Twilio's signed delivery-status callbacks. Sending still
# uses the restricted API key above when it is present.
TWILIO_AUTH_TOKEN=your-account-auth-token
# Set a Messaging Service SID or a From number; the service SID takes precedence.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=https://haulway.ca/api/webhooks/twilio/status
