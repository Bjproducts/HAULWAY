SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=job-media

# Generate a long random value. This salts anonymous rate-limit keys.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Required only for the one-time creation of the operator account.
OPERATOR_SETUP_TOKEN=replace-with-at-least-24-random-characters

# Sign-in mode. Defaults to "on": customers must enter an SMS code.
# Set to "off" ONLY while no SMS provider is funded. That opens /api/auth/direct,
# which trusts a phone number without proof — anyone who knows a customer's
# number can read their photos, addresses and chat. Set back to "on" the moment
# Twilio is live, then delete app/api/auth/direct/route.ts.
CUSTOMER_PHONE_OTP=on

# Transactional request-update SMS. Prefer a restricted Twilio API key in production.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
# Optional fallback for local testing when an API key is not configured.
TWILIO_AUTH_TOKEN=
# Set a Messaging Service SID or a From number; the service SID takes precedence.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=
